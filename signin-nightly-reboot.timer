[Unit]
Description=Daily Reboot Timer for Sign-in Scanner
Documentation=https://github.com/TAP-lab/signin-scanner

[Timer]
# Run at 1:00 AM daily
OnCalendar=*-*-* 01:00:00
# If the system was off at the scheduled time, run on next boot
Persistent=false
# Randomize execution time by up to 5 minutes to avoid simultaneous reboots
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
