# Environment variables for signin.py

# === AUTHENTICATION (choose one method) ===

# --- Recommended: JWT Bearer Flow (REST API only, no SOAP) ---
# SF_USERNAME should be a service account email address
SF_USERNAME=""
SF_CONSUMER_KEY=""
SF_PRIVATE_KEY_PATH=""
SF_DOMAIN=test

# --- Legacy: Username/Password (uses SOAP Partner API - being retired) ---
# Only used if SF_CONSUMER_KEY and SF_PRIVATE_KEY_PATH are not set
# SF_PASSWORD=""
# SF_SECURITY_TOKEN=""

# Access card SObject and fields
ACCESS_CARD_SOBJECT=Access_card__c
ACCESS_CARD_SERIAL_FIELD=Card_Serial_Number__c
ACCESS_CARD_CONTACT_FIELD=Assigned_To__c

# Sign-in SObject and fields
SIGNIN_SOBJECT=Sign_in__c
SIGNIN_CONTACT_FIELD=Contact__c
SIGNIN_SIGNIN_FIELD=Date_and_Time__c
SIGNIN_SIGNOUT_FIELD=Sign_Out_Time__c
SIGNIN_WORKSHOP_FIELD=Workshop_Name__c
SIGNIN_NAME_FIELD=Name__c
SIGNIN_RECORDTYPE_ID=012Mo000006FYVlIAO

# Workshop schedule
WORKSHOP_SOBJECT=TAP_lab_Workshop__c
WORKSHOP_NAME_FIELD=Name
WORKSHOP_START_FIELD=Start_Time__c
WORKSHOP_END_FIELD=End_Time__c
WORKSHOP_WEEKDAY_FIELD=Weekday__c
WORKSHOP_DATE_FIELD=Workshop_Date__c
WORKSHOP_LOOKAHEAD_MINUTES=90
# IANA timezone for workshop time matching - independent of the host OS
# clock's timezone (Raspberry Pi OS defaults to UTC unless reconfigured).
# Leave blank to fall back to the OS's local timezone instead.
WORKSHOP_TIMEZONE=Pacific/Auckland

# Workshop calendar sync (one-off events from an ICS feed)
# Leave WORKSHOP_ICS_URL blank to disable calendar sync entirely.
WORKSHOP_ICS_URL=""
# Weekday value written to one-off, ICS-sourced workshops so they don't
# recur weekly (no day maps to 9 in the Sun=1..Sat=7 scheme).
WORKSHOP_ONEOFF_WEEKDAY=9
# Local hour (0-23) at which the daily calendar sync runs.
WORKSHOP_SYNC_HOUR=4

# Pending card registration
PENDING_CARD_SOBJECT=Pending_card_registration__c
PENDING_CARD_SERIAL_FIELD=Card_Serial__c

# RFID debounce (seconds to ignore repeated scans of same card)
RFID_DEBOUNCE_SECONDS=5.0

# Logging
PYTHONUNBUFFERED=1
